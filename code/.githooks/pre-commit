#!/bin/sh

# Excel quotes every CSV field when saving. Normalize only the two managed log
# files, and only when they are part of the pending commit.
files=""
for file in Mng/log_Cfg.csv Mng/log_Out.csv; do
    if ! git diff --cached --quiet -- "$file"; then
        files="$files $file"
    fi
done

if [ -z "$files" ]; then
    exit 0
fi

pixi run python code/WS_Mdl/scripts/normalize_csv.py $files
